{
  "entities": {
    "LitigationCase": {
      "title": "LitigationCase",
      "description": "A legal case record with hearing schedule, filing deadlines, Google Calendar sync link, Google Keep reference, and Google Sheet tracking.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Authenticated owner UID."
        },
        "caseNumber": {
          "type": "string",
          "description": "Official docket or court case number."
        },
        "title": {
          "type": "string",
          "description": "Case title or party vs party caption."
        },
        "courtName": {
          "type": "string",
          "description": "Name of court or tribunal."
        },
        "courtRoom": {
          "type": "string",
          "description": "Courtroom or bench identifier."
        },
        "judgeName": {
          "type": "string",
          "description": "Presiding judge or bench."
        },
        "clientName": {
          "type": "string",
          "description": "Represented client name."
        },
        "clientEmail": {
          "type": "string",
          "description": "Client email for cause list updates."
        },
        "opposingParty": {
          "type": "string",
          "description": "Opposing party name."
        },
        "opposingCounsel": {
          "type": "string",
          "description": "Opposing advocate name."
        },
        "stage": {
          "type": "string",
          "description": "Current procedural stage of litigation."
        },
        "status": {
          "type": "string",
          "enum": ["active", "pending_filing", "adjourned", "disposed"],
          "description": "Current lifecycle status."
        },
        "priority": {
          "type": "string",
          "enum": ["critical", "high", "standard"],
          "description": "Urgency priority level."
        },
        "nextHearingEpochMs": {
          "type": "integer",
          "description": "Epoch milliseconds of next court hearing (0 if unset)."
        },
        "filingDeadlineEpochMs": {
          "type": "integer",
          "description": "Epoch milliseconds of next filing deadline (0 if unset)."
        },
        "hearingDurationMinutes": {
          "type": "integer",
          "description": "Estimated hearing duration in minutes."
        },
        "reminderMinutesBefore": {
          "type": "integer",
          "description": "Notification lead time before court date in minutes."
        },
        "googleKeepUrl": {
          "type": "string",
          "description": "Linked Google Keep note URL for case briefs."
        },
        "googleKeepLabel": {
          "type": "string",
          "description": "Display label for the linked Google Keep note."
        },
        "googleSheetUrl": {
          "type": "string",
          "description": "Linked Google Sheet tracker URL."
        },
        "calendarEventId": {
          "type": "string",
          "description": "Linked device CalendarContract event ID or external iCal UID."
        },
        "calendarSourceId": {
          "type": "string",
          "description": "Linked external calendar integration ID."
        },
        "notes": {
          "type": "string",
          "description": "Detailed case strategy and hearing notes."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp written via FieldValue.serverTimestamp()."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp written via FieldValue.serverTimestamp()."
        }
      },
      "required": [
        "userId",
        "caseNumber",
        "title",
        "status",
        "priority",
        "nextHearingEpochMs",
        "filingDeadlineEpochMs",
        "createdAt",
        "updatedAt"
      ]
    },
    "LitigationTask": {
      "title": "LitigationTask",
      "description": "A daily priority legal task or deadline action item optionally linked to a case and Google Keep note.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Authenticated owner UID."
        },
        "caseId": {
          "type": "string",
          "description": "Optional parent LitigationCase document ID."
        },
        "caseNumber": {
          "type": "string",
          "description": "Optional parent case number label."
        },
        "title": {
          "type": "string",
          "description": "Task title."
        },
        "description": {
          "type": "string",
          "description": "Detailed instructions."
        },
        "category": {
          "type": "string",
          "enum": ["hearing_prep", "filing", "client_call", "research", "cause_list", "general"],
          "description": "Legal workflow category."
        },
        "priority": {
          "type": "string",
          "enum": ["critical", "high", "standard"],
          "description": "Task priority."
        },
        "dueEpochMs": {
          "type": "integer",
          "description": "Due date/time in epoch milliseconds."
        },
        "completed": {
          "type": "boolean",
          "description": "Completion flag."
        },
        "reminderEnabled": {
          "type": "boolean",
          "description": "Whether automated reminder push alert is enabled."
        },
        "keepNoteUrl": {
          "type": "string",
          "description": "Optional linked Google Keep note URL."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "userId",
        "title",
        "category",
        "priority",
        "dueEpochMs",
        "completed",
        "createdAt",
        "updatedAt"
      ]
    },
    "PlatformLink": {
      "title": "PlatformLink",
      "description": "External calendar (.ics), Google Sheet URL, or Google Keep notebook link integrated without complex OAuth.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Authenticated owner UID."
        },
        "type": {
          "type": "string",
          "enum": ["ics_calendar", "google_sheet", "google_keep"],
          "description": "Integration source type."
        },
        "label": {
          "type": "string",
          "description": "Human-friendly label."
        },
        "url": {
          "type": "string",
          "description": "Shareable or secret feed URL."
        },
        "autoSync": {
          "type": "boolean",
          "description": "Whether to auto-sync on launch/refresh."
        },
        "lastSyncedEpochMs": {
          "type": "integer",
          "description": "Last successful sync timestamp."
        },
        "syncedItemCount": {
          "type": "integer",
          "description": "Number of synced records from this link."
        },
        "lastError": {
          "type": "string",
          "description": "Last sync error message if any."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "userId",
        "type",
        "label",
        "url",
        "autoSync",
        "createdAt",
        "updatedAt"
      ]
    },
    "SyncedCalendarEvent": {
      "title": "SyncedCalendarEvent",
      "description": "Real-time calendar event synchronized from linked .ics feeds or device Google Calendar.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Authenticated owner UID."
        },
        "externalUid": {
          "type": "string",
          "description": "External iCal UID or CalendarContract ID."
        },
        "sourceId": {
          "type": "string",
          "description": "Source PlatformLink ID or device_calendar."
        },
        "sourceLabel": {
          "type": "string",
          "description": "Display name of source calendar."
        },
        "title": {
          "type": "string",
          "description": "Event summary/title."
        },
        "location": {
          "type": "string",
          "description": "Courtroom or meeting location."
        },
        "description": {
          "type": "string",
          "description": "Event notes or description."
        },
        "startEpochMs": {
          "type": "integer",
          "description": "Event start timestamp in epoch millis."
        },
        "endEpochMs": {
          "type": "integer",
          "description": "Event end timestamp in epoch millis."
        },
        "allDay": {
          "type": "boolean",
          "description": "All-day event flag."
        },
        "linkedCaseId": {
          "type": "string",
          "description": "Optional linked LitigationCase ID."
        },
        "keepNoteUrl": {
          "type": "string",
          "description": "Linked Google Keep note URL for this calendar event."
        },
        "deviceEventId": {
          "type": "string",
          "description": "Device CalendarContract event row ID if mirrored locally."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "userId",
        "externalUid",
        "title",
        "startEpochMs",
        "endEpochMs",
        "allDay",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}/cases/{caseId}": {
      "schema": {
        "$ref": "#/entities/LitigationCase"
      },
      "description": "Per-user litigation case records with hearings, deadlines, Keep links, and calendar links."
    },
    "/users/{userId}/tasks/{taskId}": {
      "schema": {
        "$ref": "#/entities/LitigationTask"
      },
      "description": "Per-user daily priority legal tasks and deadline reminders."
    },
    "/users/{userId}/integrations/{integrationId}": {
      "schema": {
        "$ref": "#/entities/PlatformLink"
      },
      "description": "Per-user linked calendar feeds (.ics), Google Sheet URLs, and Google Keep links."
    },
    "/users/{userId}/calendar_events/{eventId}": {
      "schema": {
        "$ref": "#/entities/SyncedCalendarEvent"
      },
      "description": "Per-user synchronized calendar events bridged with Google Calendar and .ics feeds."
    }
  }
}
